//@version=6
indicator("Sverfund Pair Spread", overlay=false)

// ── Inputs ─────────────────────────────────────────────
symbol2  = input.symbol("SAXO:EURUSD", "Pair Symbol (X)")
window   = input.int(86, "Regression Window (bars)", minval=5)
z_window = input.int(8, "Z-Score Window (bars)", minval=2)
useLog   = input.bool(true, "Use Log Prices")
zThresh  = input.float(2.0, "Entry Z-Score Threshold", minval=0.5, step=0.1)
srcY     = input.source(close, "Y Source (current chart)")

// ── Symbol Names ───────────────────────────────────────
tickerY = syminfo.ticker(syminfo.tickerid)
tickerX = syminfo.ticker(symbol2)

// ── Data ───────────────────────────────────────────────
srcX_raw = request.security(symbol2, timeframe.period, close, lookahead=barmerge.lookahead_off)

y = useLog ? math.log(srcY)     : srcY
x = useLog ? math.log(srcX_raw) : srcX_raw

// ── Rolling OLS (beta = cov(x,y)/var(x), alpha = mean_y - beta*mean_x) ──
meanX  = ta.sma(x, window)
meanY  = ta.sma(y, window)
meanXY = ta.sma(x * y, window)
meanXX = ta.sma(x * x, window)

covXY = meanXY - meanX * meanY
varX  = meanXX - meanX * meanX

beta  = varX != 0 ? covXY / varX : na
alpha = meanY - beta * meanX

// ── Spread & Z-score ──────────────────────────────────
spread = y - (alpha + beta * x)

zMean  = ta.sma(spread, z_window)
zStd   = ta.stdev(spread, z_window)
zscore = zStd != 0 ? (spread - zMean) / zStd : na

// ── Signal zones (for background shading only) ────────
longY  = zscore <= -zThresh
shortY = zscore >= zThresh

// ── Plot ───────────────────────────────────────────────
plot(zscore, "Z-Score", color=color.blue, linewidth=2)
hline(0, "Mean", color=color.gray)
hline(zThresh, "+Threshold", color=color.red, linestyle=hline.style_dashed)
hline(-zThresh, "-Threshold", color=color.green, linestyle=hline.style_dashed)
hline(1, "+1σ", color=color.gray, linestyle=hline.style_dotted)
hline(-1, "-1σ", color=color.gray, linestyle=hline.style_dotted)

bgcolor(shortY ? color.new(color.red, 90) : longY ? color.new(color.green, 90) : na)

// ── Info Table (beta / alpha / z / pair) ──────────────
var table infoTable = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "Beta",  text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 0, str.tostring(beta, "#.####"), text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 0, 1, "Alpha", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 1, str.tostring(alpha, "#.####"), text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 0, 2, "Z",     text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 2, str.tostring(zscore, "#.##"), text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 0, 3, "Pair",  text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 3, tickerY + " / " + tickerX, text_color=color.white, bgcolor=color.gray)

// Pair X/Y ===> 
//      z < -3 buy X sell beta*Y
//      z > 3  sell X buy beta*Y