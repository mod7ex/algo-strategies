//@version=6
strategy("30-Min Session Breakout (Stop Entries)", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0,
     calc_on_every_tick=true, process_orders_on_close=false)

// ───────────────────────────────
// Inputs
// ───────────────────────────────
tfInput          = input.timeframe("30", title="Strategy Timeframe", group="Strategy Inputs")
candleTimeInput  = input.string("19:30", title="Candle Close Time (HH:MM)", group="Strategy Inputs")
tzInput          = input.string("Etc/UTC", title="Timezone", tooltip="Must match the timezone your chart is displayed in (Chart Settings → Timezone). Examples: 'Etc/UTC', 'America/New_York', 'Europe/London', 'exchange'.", group="Strategy Inputs")
rr               = input.float(3.0, title="Risk Reward Ratio", minval=0.1, group="Strategy Inputs")

// ───────────────────────────────
// Parse the target candle's CLOSE time into its OPEN (bar) time
// ───────────────────────────────
timeParts   = str.split(candleTimeInput, ":")
closeHour   = str.tonumber(array.get(timeParts, 0))
closeMinute = str.tonumber(array.get(timeParts, 1))
tfMinutes   = str.tonumber(tfInput)

closeTotalMin = closeHour * 60 + closeMinute
openTotalMin  = (closeTotalMin - tfMinutes + 1440) % 1440
targetOpenHour   = math.floor(openTotalMin / 60)
targetOpenMinute = openTotalMin % 60

// ───────────────────────────────
// Detect the moment the target candle closes
// (bar's OPEN time matches target, in the chosen timezone, and bar is confirmed/closed)
// ───────────────────────────────
isTargetBar   = (hour(time, tzInput) == targetOpenHour) and (minute(time, tzInput) == targetOpenMinute)
triggerCandle = isTargetBar and barstate.isconfirmed

// ───────────────────────────────
// Capture High/Low of the trigger candle and place bracket stop orders
// (sizing is left to TradingView's own settings — Properties tab / default_qty_*)
// ───────────────────────────────
var float longStop  = na
var float shortStop = na
var float riskPts   = na

if triggerCandle
    longStop  := high
    shortStop := low
    riskPts   := high - low

    strategy.entry("Long",  strategy.long,  stop=longStop,  oca_name="BreakoutOCA", oca_type=strategy.oca.cancel, comment="Long Stop")
    strategy.entry("Short", strategy.short, stop=shortStop, oca_name="BreakoutOCA", oca_type=strategy.oca.cancel, comment="Short Stop")

// ───────────────────────────────
// Exits: SL at the opposite side of the range, TP at RR multiple
// ───────────────────────────────
if not na(longStop) and not na(shortStop) and not na(riskPts)
    strategy.exit("Long Exit",  from_entry="Long",  stop=shortStop, limit=longStop  + riskPts * rr)
    strategy.exit("Short Exit", from_entry="Short", stop=longStop,  limit=shortStop - riskPts * rr)

// ───────────────────────────────
// Visuals
// ───────────────────────────────
plot(triggerCandle ? high : na, title="Trigger High", style=plot.style_circles, color=color.green, linewidth=2)
plot(triggerCandle ? low  : na, title="Trigger Low",  style=plot.style_circles, color=color.red,   linewidth=2)

var line hiLine = na
var line loLine = na
if triggerCandle
    line.delete(hiLine)
    line.delete(loLine)
    hiLine := line.new(bar_index, longStop,  bar_index + 50, longStop,  color=color.green, style=line.style_dashed)
    loLine := line.new(bar_index, shortStop, bar_index + 50, shortStop, color=color.red,   style=line.style_dashed)